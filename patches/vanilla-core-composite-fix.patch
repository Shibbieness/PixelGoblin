@@ -0,0 +1,39 @@
+"""Composite runs: two flavors that share an entrypoint module name must each
+run their own code. Regression test for the collision found when PixelGoblin
+became the second real flavor."""
+
+import tempfile
+import unittest
+from pathlib import Path
+
+from vanilla_core.registry import load_flavor
+
+MANIFEST = """[flavor]
+name = "{name}"
+version = "0.1.0"
+license = "MIT"
+entrypoint = "vanilla_flavor:run"
+capabilities = ["who"]
+"""
+PLUGIN = """def run(capability=None, params=None):
+    return {{"flavor": "{name}"}}
+"""
+
+
+class TestCompositeLoad(unittest.TestCase):
+    def test_same_module_name_does_not_collide(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            paths = []
+            for name in ("alpha", "beta"):
+                d = Path(tmp, name)
+                d.mkdir()
+                (d / "flavor.toml").write_text(MANIFEST.format(name=name))
+                (d / "vanilla_flavor.py").write_text(PLUGIN.format(name=name))
+                paths.append(d / "flavor.toml")
+            a, b = (load_flavor(p) for p in paths)
+            self.assertEqual(a.invoke("who"), {"flavor": "alpha"})
+            self.assertEqual(b.invoke("who"), {"flavor": "beta"})
+
+
+if __name__ == "__main__":
+    unittest.main()
