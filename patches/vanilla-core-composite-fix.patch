     with _flavor_on_path(str(manifest.path) if manifest.path else None):
-        module = importlib.import_module(module_name)
+        # Two flavors may use the same entrypoint module name (QRen Coder and
+        # PixelGoblin both use `vanilla_flavor`). importlib caches by name, so
+        # without this the second flavor silently receives the first one's
+        # module and runs the wrong code. Import fresh, then take the name back
+        # out of the cache so the next flavor gets its own module.
+        previous = sys.modules.pop(module_name, None)
+        try:
+            module = importlib.import_module(module_name)
+        finally:
+            sys.modules.pop(module_name, None)
+            if previous is not None:
+                sys.modules[module_name] = previous
 
     run = getattr(module, callable_name)
     return LoadedFlavor(manifest=manifest, run=run)
